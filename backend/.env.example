# 复制为 backend/.env 后填写。.env 已在 .gitignore 里，不会进版本库。
#
# 三种部署方式都走 OpenAI 兼容协议，只改下面三行即可切换。

# ---- 阿里云百炼（推荐，课设演示最快接通）----
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=sk-把这里换成你的key
MODEL_NAME=qwen-plus

# ---- 本地 vLLM（离线、免费，需要显卡）----
# MODEL_BASE_URL=http://localhost:8000/v1
# MODEL_API_KEY=EMPTY
# MODEL_NAME=qwen3-8b

# ---- Ollama（装完就能跑，吞吐低）----
# MODEL_BASE_URL=http://localhost:11434/v1
# MODEL_API_KEY=EMPTY
# MODEL_NAME=qwen3:8b

# ---- 其它 ----
# 单次模型调用超时
MODEL_TIMEOUT=90s
# 决策类任务要稳定，温度保持很低
MODEL_TEMPERATURE=0.1
# 同进程内模型调用的并发上限。默认 1（串行）：并发调用会让端点长时间不响应直到超时。
MODEL_MAX_CONCURRENCY=1
# 服务监听地址
SERVER_ADDR=:8080

# ---- 联网检索（数据技能用）----
# 必须走百炼原生端点：OpenAI 兼容端点会静默忽略 enable_search，
# 模型会退回凭记忆回答，从而编造内容（实测过）。
