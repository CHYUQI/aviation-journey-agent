@startuml
' 图2-1 系统体系结构逻辑视图（当前实现）
' 约束：只描述分层与职责，不出现具体包名、类名、方法名
' 依据：docs/api/openapi.yaml 与当前代码（backend/internal、frontend/src）

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 15
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 30
skinparam ArrowColor #46617A
skinparam ArrowFontSize 12
skinparam ArrowFontColor #2F3E4E
skinparam componentBorderColor #1F4E79
skinparam componentBackgroundColor #EEF4FA
skinparam componentFontColor #10304C
skinparam packageBorderColor #1F4E79
skinparam packageFontColor #1F4E79
skinparam noteBackgroundColor #FFF7E0
skinparam noteBorderColor #B99A4A
skinparam noteFontSize 12

title 图2-1 系统体系结构逻辑视图（当前实现）

package "① 客户端层（旅客界面）" as L1 {
  component "行程创建\n表单校验" as CForm
  component "车态展示\n时间轴·行动卡片" as CView
  component "定位与阶段\n位置上报" as CLoc
  component "提醒与导航\n点击后跳转" as CNav
}

package "② 接口层（HTTP 与实时通道）" as L2 {
  component "创建行程接口\n异步受理" as ICreate
  component "位置/阶段接口\n触发重算" as IUpdate
  component "快照查询接口\n只读" as IState
  component "实时订阅通道\n断线重连" as IStream
}

package "③ 运行时编排层" as L3 {
  component "行程编排\n创建·更新·重算" as RLife
  component "刷新与去重\n单行程不排队" as RPolicy
  note bottom of RPolicy
    位置或阶段变化后立即重算并推送，
    不等周期刷新
  end note
}

package "④ 分析与决策层（双 Agent 协同）" as L4 {
  component "数据感知 Agent\n取数并评估质量" as AData
  component "行动决策 Agent\n阶段·风险·建议" as AAdvice
  component "数据技能集合\n航班·机场·路程" as ASkill
  component "模型接入\nOpenAI 兼容" as AModel
}

package "⑤ 存储与推送层" as L5 {
  component "快照存储\n进程内" as SStore
  component "订阅与广播\n全量快照" as SPush
}

package "⑥ 外部能力" as L6 {
  component "航班与机场数据源\n（聚合站点）" as XData
  component "大模型服务" as XModel
  component "地图导航应用/网页" as XMap
  component "开发期假后端" as XMock
}

' ===== 协作关系 =====
CForm --> ICreate : 提交行程
CLoc --> IUpdate : 上报坐标或阶段
CView --> IState : 拉取快照
CView --> IStream : 订阅快照
CNav --> XMap : 点击后打开
ICreate --> RLife
IUpdate --> RLife
IState --> SStore : 读取
IStream --> SPush : 订阅
RLife --> AData : 先取数
RLife --> AAdvice : 后决策
RLife --> SStore : 保存
RLife --> SPush : 广播
AData --> ASkill : 按缺失字段调用
ASkill --> XData : HTTPS
AAdvice --> AModel : 生成建议
AModel --> XModel : HTTPS
SPush --> IStream : 推送
XMock .up.> ICreate : 开发联调替代

@enduml
