@startuml
' 图2-1 系统体系结构逻辑视图（当前实现）
' 依据：docs/api/openapi.yaml 与当前代码（backend/internal、frontend/src）
' 插入建议：横向整页（约 24cm 宽）时图内字号约 8pt，可读；若只放 14cm 正文栏，请把本图拆成上下两张

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 18
skinparam ranksep 30
skinparam ArrowColor #46617A
skinparam ArrowFontSize 12
skinparam ArrowFontColor #2F3E4E
skinparam componentBorderColor #1F4E79
skinparam componentBackgroundColor #EEF4FA
skinparam componentFontColor #10304C
skinparam packageBorderColor #1F4E79
skinparam packageFontColor #1F4E79
skinparam noteBackgroundColor #FFF7E0
skinparam noteBorderColor #B99A4A
skinparam noteFontSize 12

title 图2-1 系统体系结构逻辑视图（当前实现）

package "① 客户端层（浏览器 · Vue 3 + TypeScript SPA）" as L1 {
  component "Vue 3 SPA\nDashboard.vue：创建表单与 idle/processing/ready/failed 三态\nuseJourneyStore（Pinia）：快照与 20s 断线→15s 轮询回退\nuseLocation 与 8 个展示/交互组件" as Client
  component "api/journey.ts\ncreateJourney / getState\nupdateLocation / createStream" as ApiTs
}

package "② 接口层（Gin HTTP，统一前缀 /api/v1）" as L2 {
  component "api.RegisterRoutes\nPOST /journey\nPOST /journey/{id}/location\nGET /journey/{id}/state\nGET /journey/{id}/stream" as Routes
  component "api.JourneyHandler\nCreate · UpdateLocation\nState · Stream" as Handler
  component "SSE 协议适配\nretry: 5000\nevent: snapshot / heartbeat(15s)" as SSEProto
}

package "③ 运行时编排层（单个 Go 进程）" as L3 {
  component "runtime.Runtime\n编排取数与决策、读写快照、订阅推送\nCreateJourney · ApplyLocation · Recalculate\nGetSnapshot · Subscribe · StartPeriodicRefresh" as Rt
  component "并发与刷新策略\nbusy.LoadOrStore 去重，不排队\n单次分析超时 180s\n每行程刷新间隔不小于 2min；终态跳过" as RtPolicy
  note right of RtPolicy
    位置或阶段更新后立即重算并推送，不等周期；
    finish 先 SaveSnapshot 再 Publish
  end note
}

package "④ Agent 与技能层（与 Runtime 同进程）" as L4 {
  component "data.Agent\nBuildState(ctx, Input{Journey, Progress})\n缺失字段 → Registry.Query → 观测值校验\n→ assessQuality：complete/degraded/unknown" as DataAgent
  component "advice.Agent\nEvaluate(ctx, Input{State, Progress, Issues,\nAirportIATA, HasBaggage})\n模型未配置或调用失败 → degraded(risk=unknown)" as AdviceAgent
  component "skill.Registry\nRegister(s) / Query(ctx, query)" as Registry
  component "数据技能（skill.Skill 实现）\nFlightIdentitySkill：EOOB 航班号搜索（5min 缓存）\nFlightStatusSkill：EOOB 状态 JSON\nAirportStatusSkill：EOOB 机场页与延误接口\nRouteETASkill：直线距离×1.3÷30km/h（low）" as Skills
  component "model.Client → model.OpenAI\nChat(ctx, req)\nOpenAI 兼容端点（百炼/vLLM/Ollama）" as ModelClient
  note bottom of DataAgent
    没有观测值的字段一律 null；单个 Skill 失败只追加 issue
  end note
  note bottom of AdviceAgent
    关键数据缺失 → risk=unknown 并过滤带 Nav 的行动；
    不执行改签、支付、叫车
  end note
}

package "⑤ 存储与推送层（进程内，无数据库）" as L5 {
  component "store.MemoryStore\njourneys · snapshots · progress\nRWMutex · 重启即丢失" as Ms
  component "runtime.SSEHub\nsubs · 缓冲 4 · 非阻塞 Publish\nSubscribe(id) → (channel, cancel)" as Hub
}

package "⑥ 外部能力（进程外）" as L6 {
  component "EOOB 聚合站点\napil.eoob.com：航班搜索 / 状态 JSON\nwww.eoob.com.cn：机场页 + delaybox\n（v1 唯一航班与机场数据来源）" as EOOB
  component "模型服务\nOpenAI 兼容 API\n未配置时整链路仍可运行" as LLM
  component "高德 App / 网页\namapuri:// 与 uri.amap.com\n仅用户点击后打开" as Amap
  component "mockserver（:8081）\n开发期夹具：正常 / MU9999 / FAIL" as Mock
}

' ===== 关键协作关系（自左向右、自上而下为调用方向）=====
Client --> ApiTs : 提交行程 / 触发定位
ApiTs --> Routes : HTTP JSON（POST /journey、POST /location、GET /state）
ApiTs --> SSEProto : EventSource 订阅 /stream
Routes --> Handler : 路由分发
Handler --> Rt : 调用 Runtime，不含 Agent 规则
Rt --> DataAgent : BuildState(ctx, Input)
Rt --> AdviceAgent : decide() 后 Evaluate(ctx, Input)\n状态无实质变化时复用上一版建议
Rt --> Ms : Save / Get Journey · Progress · Snapshot
Rt --> Hub : Publish(id, snapshot)
Hub --> Handler : snapshot channel → event: snapshot
DataAgent --> Registry : Query(ctx, query)
Registry --> Skills : Execute(ctx, query)
AdviceAgent --> ModelClient : Chat(ctx, req)
Skills --> EOOB : HTTPS JSON / HTML
ModelClient --> LLM : HTTPS
Client --> Amap : NavigateButton.open（App 优先，1.2s 回退 Web）
Mock .up.> Routes : 开发联调时替代真实后端

@enduml
