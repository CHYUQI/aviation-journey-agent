@startuml
' 图2-1 系统体系结构逻辑视图（当前实现）
' 约束：只描述分层与职责，不出现具体包名、类名、方法名
' 依据：docs/api/openapi.yaml 与当前代码（backend/internal、frontend/src）

skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 14
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 32
skinparam ArrowColor #46617A
skinparam ArrowFontSize 12
skinparam ArrowFontColor #2F3E4E
skinparam componentBorderColor #1F4E79
skinparam componentBackgroundColor #EEF4FA
skinparam componentFontColor #10304C
skinparam packageBorderColor #1F4E79
skinparam packageFontColor #1F4E79
skinparam noteBackgroundColor #FFF7E0
skinparam noteBorderColor #B99A4A
skinparam noteFontSize 12

title 图2-1 系统体系结构逻辑视图（当前实现）

package "① 客户端层（旅客界面）" as L1 {
  component "行程创建表单" as CForm
  component "状态 / 时间轴 / 行动卡片展示" as CView
  component "定位与阶段确认" as CLoc
  component "提醒与导航跳转" as CNav
}

package "② 接口层（HTTP 接口与实时通道）" as L2 {
  component "创建行程接口" as ICreate
  component "位置或阶段上报接口" as IUpdate
  component "快照查询接口" as IState
  component "实时订阅通道" as IStream
}

package "③ 运行时编排层" as L3 {
  component "行程生命周期编排\n创建 / 更新 / 异步重算" as RLife
  component "并发去重与刷新策略\n单行程不排队，终态不再刷新" as RPolicy
  note bottom of RPolicy
    位置或阶段更新后立即重算并推送，
    不等周期刷新
  end note
}

package "④ 分析与决策层（双 Agent 协同）" as L4 {
  component "数据感知 Agent\n按缺失字段取数\n校验观测值并评估数据质量" as AData
  component "行动决策 Agent\n生成阶段、风险、\n提醒与行动建议" as AAdvice
  component "数据技能集合" as ASkill
  component "模型接入\nOpenAI 兼容接口" as AModel
}

package "⑤ 存储与推送层" as L5 {
  component "进程内快照存储\n行程 / 快照 / 位置进度" as SStore
  component "订阅与广播\n全量快照推送" as SPush
}

package "⑥ 外部能力" as L6 {
  component "航班与机场数据源\n（EOOB 聚合站点）" as XData
  component "大模型服务" as XModel
  component "地图导航应用 / 网页\n仅用户点击后打开" as XMap
  component "开发期假后端（可选）" as XMock
}

' ===== 协作关系 =====
CForm --> ICreate : 提交行程
CLoc --> IUpdate : 上报坐标或阶段
CView --> IState : 拉取当前快照
CView --> IStream : 订阅实时快照
CNav --> XMap : 用户点击后打开
ICreate --> RLife
IUpdate --> RLife
IState --> SStore : 读取快照
IStream --> SPush : 建立订阅
RLife --> AData : 先取数
RLife --> AAdvice : 后决策
RLife --> SStore : 保存完整快照
RLife --> SPush : 广播完整快照
AData --> ASkill : 按缺失字段调用
ASkill --> XData : HTTPS
AAdvice --> AModel : 生成建议
AModel --> XModel : HTTPS
SPush --> IStream : 推送快照
XMock .up.> ICreate : 开发联调替代后端

@enduml
